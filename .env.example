# Proyecto de Supabase (Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co

# Clave PUBLICABLE (sb_publishable_...), nunca la secret: esta viaja al navegador
SUPABASE_KEY=<publishable-key>

# Dominio de producción, sin barra final.
# Define el canonical, el og:url, el sitemap.xml y el JSON-LD.
NUXT_PUBLIC_SITE_URL=https://landing-suma.vercel.app
